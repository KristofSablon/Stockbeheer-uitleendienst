# ── Lokale ontwikkeling (SQLite) ────────────────────────────────────────────
# Databank (SQLite voor lokale ontwikkeling en Codespaces)
DATABASE_URL="file:./dev.db"

# Geheime sleutel voor sessie-ondertekening (genereer een lange, willekeurige waarde)
SESSION_SECRET="wijzig-dit-naar-een-lange-willekeurige-geheime-sleutel"

# ── Productie op Vercel (PostgreSQL) ────────────────────────────────────────
# In productie gebruikt de app PostgreSQL i.p.v. SQLite. Wanneer je in Vercel de
# opslag "Postgres" (Neon) toevoegt, worden deze twee variabelen automatisch
# ingesteld — je hoeft ze dan niet handmatig in te vullen:
#
#   POSTGRES_PRISMA_URL       (gepoolde verbinding, voor de app)
#   POSTGRES_URL_NON_POOLING  (directe verbinding, voor migraties/db push)
#
# Stel in Vercel ook een sterke SESSION_SECRET in bij de Environment Variables.
# Zie DEPLOY.md voor de volledige stappen.

# ── Productie op Azure (PostgreSQL) ─────────────────────────────────────────
# Op Azure App Service volstaat één variabele voor de databank:
#   DATABASE_URL="postgresql://gebruiker:wachtwoord@server.postgres.database.azure.com:5432/uitleendienst?sslmode=require"
# Zie DEPLOY-AZURE.md voor de volledige stappen.

# ── Aanmelden met het gemeente-account (Microsoft Entra ID / SSO) ───────────
# Actief zodra deze drie variabelen zijn ingesteld (uit de Entra app-registratie).
# ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_SECRET="..."
#
# Rol voor nieuwe SSO-gebruikers zonder toegewezen app role (leeg = geen toegang):
# ENTRA_STANDAARD_ROL="BELEID"
#
# Zet op "1" om de wachtwoord-login te verbergen zodra SSO actief is:
# LOKAAL_AANMELDEN_UIT="1"

# ── Insluiten in SharePoint (optioneel) ─────────────────────────────────────
# Laat de app toe in een iframe op jullie SharePoint-site:
# FRAME_ANCESTORS="https://gemeente.sharepoint.com"
